{
  "manifest_version": 3,
  "name": "Wealth Whisper Sync",
  "version": "1.0.0",
  "description": "Automatically syncs bKash transactions from Google Messages Web to the Wealth Whisper ledger.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://messages.google.com/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://messages.google.com/*"],
      "js": ["messages_content.js"]
    },
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["tracker_content.js"]
    }
  ]
}
